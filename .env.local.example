# Supabase — get from: https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here
NEXT_PUBLIC_SITE_URL=https://common-table-beta.vercel.app

# Google OAuth is configured in the Supabase dashboard:
# Authentication → Providers → Google
# Add your Google Client ID + Secret there (not here)
#
# Also add to Google Cloud Console → Authorized redirect URIs:
# https://your-project-ref.supabase.co/auth/v1/callback
